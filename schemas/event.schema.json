{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/agent-registry-protocol/schemas/event.schema.json",
  "title": "ARPA Event Record",
  "description": "A single event in a subject's or registry's ordered event stream. Candidate base values follow §24.2; controlled project extensions and deprecated migration aliases are enumerated from registries/event-types.json.",
  "x-spec-section": "24.3",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "agent.registered",
        "agent.activated",
        "agent.updated",
        "agent.restricted",
        "agent.suspended",
        "agent.quarantined",
        "agent.compromised",
        "agent.revoked",
        "agent.retired",
        "agent.superseded",
        "agent.control_changed",
        "agent.operator_changed",
        "agent.accountable_entity_changed",
        "version.published",
        "deployment.created",
        "deployment.attested",
        "deployment.restricted",
        "delegation.issued",
        "delegation.narrowed",
        "delegation.suspended",
        "delegation.revoked",
        "assurance.issued",
        "assurance.expired",
        "assurance.suspended",
        "assurance.revoked",
        "incident.opened",
        "incident.updated",
        "incident.closed",
        "appeal.filed",
        "appeal.decided",
        "status.restored",
        "recognition.added",
        "recognition.changed",
        "recognition.withdrawn",
        "agent.metadata.updated",
        "controller.changed",
        "operator.changed",
        "alias.added",
        "alias.revoked",
        "key.rotated"
      ]
    },
    "subject": {
      "type": "string",
      "pattern": "^agentreg:[A-Za-z0-9.-]{1,253}:[A-Za-z0-9._:-]{1,255}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "subject",
    "sequence",
    "occurred_at",
    "effective_at",
    "issuer",
    "reason_code"
  ]
}

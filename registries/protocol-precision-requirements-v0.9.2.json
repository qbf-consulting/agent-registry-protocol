{
  "registry": "protocol-precision-requirements",
  "arpa_version": "0.9.2",
  "source": "spec/agent-registry-protocol-v0.9.2-protocol-precision.md",
  "entries": [
    {
      "id": "ARPA-PREC-ID-001",
      "section": "1. ARPA Agent Identifier",
      "requirement": "The protocol Agent Identifier used for ARPA Core interchange MUST use the agentreg URI scheme.",
      "verification": ["PREC-001", "inspection"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-ID-002",
      "section": "1. ARPA Agent Identifier",
      "requirement": "External identifiers MUST remain distinguishable from the ARPA Agent Identifier.",
      "verification": ["PREC-002"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-ID-003",
      "section": "1. ARPA Agent Identifier",
      "requirement": "Unsupported identifier schemes MUST NOT be silently reinterpreted as ARPA Agent Identifiers.",
      "verification": ["PREC-003"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-HIST-001",
      "section": "2. Historical resolution result contract",
      "requirement": "Historical resolution MUST identify requested time, resolution time, selected-record provenance, later material events and reconstruction status or quality.",
      "verification": ["PREC-004", "inspection"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json", "artifacts/conformance/historical-resolution-validation.json"]
    },
    {
      "id": "ARPA-PREC-HIST-002",
      "section": "2. Historical resolution result contract",
      "requirement": "A registry MUST NOT silently substitute current state for requested-time state.",
      "verification": ["PREC-005"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json", "artifacts/conformance/historical-resolution-validation.json"]
    },
    {
      "id": "ARPA-PREC-HIST-003",
      "section": "2. Historical resolution result contract",
      "requirement": "Unavailable, conflicting or integrity-failed material historical evidence MUST remain non-affirmative.",
      "verification": ["PREC-006"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json", "artifacts/conformance/historical-resolution-validation.json"]
    },
    {
      "id": "ARPA-PREC-ERR-001",
      "section": "3. HTTP Problem Details contract",
      "requirement": "Protocol-significant ARPA HTTP failures MUST use RFC 9457 Problem Details unless another governing transport profile defines an interoperable error representation.",
      "verification": ["PREC-007", "inspection"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-ERR-002",
      "section": "3. HTTP Problem Details contract",
      "requirement": "ARPA Problem Details MUST contain stable type, status and ARPA code machine semantics.",
      "verification": ["PREC-008", "inspection"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-ERR-003",
      "section": "3. HTTP Problem Details contract",
      "requirement": "Human-readable title and detail MUST NOT be the sole machine contract for client behaviour.",
      "verification": ["PREC-009"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-ERR-004",
      "section": "3. HTTP Problem Details contract",
      "requirement": "Unknown protocol-significant error semantics MUST NOT be interpreted as success.",
      "verification": ["PREC-010"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-EXT-001",
      "section": "4. Critical extensions and version handling",
      "requirement": "A material critical extension MUST identify a namespace and version sufficient to determine support.",
      "verification": ["PREC-011"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-EXT-002",
      "section": "4. Critical extensions and version handling",
      "requirement": "An unsupported material critical extension MUST produce a non-affirmative result or protocol error and MUST NOT be ignored.",
      "verification": ["PREC-012"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-EXT-003",
      "section": "4. Critical extensions and version handling",
      "requirement": "Unknown non-critical extensions MAY be ignored only when doing so cannot change core semantics or broaden authority.",
      "verification": ["PREC-013"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    },
    {
      "id": "ARPA-PREC-XART-001",
      "section": "5. Cross-artifact consistency",
      "requirement": "Release validation MUST fail when machine-readable contracts contradict the v0.9.2 precision semantics.",
      "verification": ["PREC-014", "inspection"],
      "expected_evidence": ["artifacts/conformance/protocol-precision-validation.json"]
    }
  ]
}
